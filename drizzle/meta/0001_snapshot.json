      "checkConstraints": {
        "orders_amount_positive": {
          "name": "orders_amount_positive",
          "value": "\"orders\".\"amount_minor\">0 AND \"orders\".\"amount_minor\"<=100000000"
        },
        "orders_mode_valid": {
          "name": "orders_mode_valid",
          "value": "\"orders\".\"mode\" IN ('test','live')"
        },
        "orders_payment_valid": {
          "name": "orders_payment_valid",
          "value": "\"orders\".\"payment_status\" IN ('unpaid','checkout_pending','paid','cancelled')"
        },
        "orders_fulfillment_valid": {
          "name": "orders_fulfillment_valid",
          "value": "\"orders\".\"fulfillment_status\" IN ('awaiting_payment','queued','in_progress','delivered')"
        }
      }
